    {
      "name": "get_card_details",
      "action_type": "read",
      "requires_confirmation": false,
      "output_schema": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "card_id": {
                  "type": "string"
                },
                "masked_number": {
                  "type": "string",
                  "description": "display-only, e.g. '****4321'"
                },
                "card_type": {
                  "type": "string",
                  "enum": [
                    "credit",
                    "debit",
                    "prepaid"
                  ]
                },
                "network": {
                  "type": "string",
                  "enum": [
                    "visa",
                    "mastercard",
                    "rupay",
                    "amex"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "frozen (reversible)",
                    "blocked (permanent)",
                    "inactive",
                    "expired"
                  ]
                },
                "credit_limit": {
                  "type": "number",
                  "description": "present for credit cards only; absent for debit and prepaid card types."
                },
                "available_limit": {
                  "type": "number",
                  "description": "present for credit cards only; absent for debit and prepaid card types."
                },
                "controls": {
                  "type": "object",
                  "description": "{atm, online, pos}, each {domestic: {enabled, daily_limit}, international: {enabled, daily_limit}}"
                },
                "expiry": {
                  "type": "string",
                  "description": "MM/YY"
                }
              }
            },
            "description": "One entry per card."
          }
        },
        "required": [
          "cards"
        ]
