{
  "schema_version": "1.0-harness",
  "note": "Harness-only companion to tools.json. Carries the fields the harness needs and the candidate must NOT see: output_schema (mock record shapes, the total_count branch and the result-wrapper name in mock_executor), action_type / requires_confirmation (S2 write detection in grader.py and case_lint.py), and call_before (the prerequisite-reachability check over the case bank). Everything the model is allowed to read - the description prose, the parameter schemas and the enums - lives in tools.json and is deliberately NOT duplicated here; the two files are joined on `name` by harness.tools.load_tool_definitions().",
  "tool_count": 32,
  "tools": [
    {
      "name": "search_knowledge_base",
      "action_type": "read",
      "requires_confirmation": false,
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "chunk": {
                  "type": "string",
                  "description": "retrieved text; quote or paraphrase this when grounding a policy answer."
                },
                "source": {
                  "type": "string",
                  "description": "title, circular number, or URL identifying the source document."
                }
              }
            },
            "description": "Ranked list of retrieved text chunks, most relevant first."
          }
        },
        "required": [
          "results"
        ]
      }
    },
    {
